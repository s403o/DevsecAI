{
  "name": "devsec-ai",
  "version": "2.0.0",
  "description": "Autonomous Multi-Agent GitHub PR Reviewer & Security Auditing Platform",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "review:demo": "tsx examples/run-review.ts",
    "demo:features": "tsx examples/run-all-features.ts",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
