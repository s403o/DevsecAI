  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@octokit/rest": "^21.0.2",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "vitest": "^3.2.7"
  }
}
